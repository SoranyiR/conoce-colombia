<?xml version="1.0" encoding="utf-8"?>

<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_foto_card"
    android:elevation="2dp"
    android:padding="10dp"
    android:layout_marginBottom="10dp">

    <!-- PARTE SUPERIOR -->

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <ImageView
            android:id="@+id/imgFoto"
            android:layout_width="88dp"
            android:layout_height="72dp"
            android:scaleType="centerCrop"
            android:background="@drawable/bg_foto_image"
            android:clipToOutline="true"
            android:contentDescription="Imagen de destino turístico" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="12dp">

            <TextView
                android:id="@+id/txtTituloFoto"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Cartagena"
                android:textColor="@color/text_primary"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="📍 Destino turístico"
                android:textColor="@color/app_primary"
                android:textSize="10sp"
                android:textStyle="bold"
                android:layout_marginTop="4dp" />

        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="›"
            android:textColor="@color/app_primary"
            android:textSize="26sp"
            android:textStyle="bold"
            android:paddingStart="6dp" />

    </LinearLayout>

    <!-- DESCRIPCIÓN PROPIA DEL DESTINO -->

    <TextView
        android:id="@+id/txtDescripcionItem"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Descripción del destino turístico."
        android:textColor="@color/text_secondary"
        android:textSize="10sp"
        android:lineSpacingExtra="2dp"
        android:layout_marginTop="9dp"
        android:paddingStart="4dp"
        android:paddingEnd="4dp"
        android:paddingBottom="3dp" />

</LinearLayout>