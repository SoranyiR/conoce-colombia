<?xml version="1.0" encoding="utf-8"?>

<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@color/app_background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="12dp"
        android:paddingTop="12dp"
        android:paddingEnd="12dp"
        android:paddingBottom="20dp">


        <!-- ===================================================== -->
        <!-- TÍTULO -->
        <!-- ===================================================== -->

        <TextView
            android:id="@+id/txtTituloPerfil"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="👤 Perfil"
            android:textColor="@color/text_primary"
            android:textSize="18sp"
            android:textStyle="bold"
            android:paddingBottom="10dp" />


        <!-- ===================================================== -->
        <!-- TARJETA PRINCIPAL -->
        <!-- ===================================================== -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/bg_profile_hero"
            android:elevation="2dp"
            android:padding="12dp">

            <!-- FOTO -->

            <ImageView
                android:id="@+id/imgPerfil"
                android:layout_width="70dp"
                android:layout_height="70dp"
                android:src="@drawable/guia_turistico"
                android:scaleType="centerCrop"
                android:background="@drawable/bg_profile_image"
                android:clipToOutline="true"
                android:contentDescription="Fotografía del guía turístico" />


            <!-- INFORMACIÓN -->

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginStart="12dp">

                <TextView
                    android:id="@+id/txtNombre"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Jaider Pastrana"
                    android:textColor="@color/text_primary"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:maxLines="2" />

                <TextView
                    android:id="@+id/txtProfesion"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Guía turístico"
                    android:textColor="@color/app_primary"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:layout_marginTop="3dp" />


                <!-- CHIPS -->

                <HorizontalScrollView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="7dp"
                    android:scrollbars="none">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="🌴 Turismo"
                            android:textSize="9sp"
                            android:textColor="#5B43B4"
                            android:background="@drawable/bg_chip"
                            android:paddingStart="8dp"
                            android:paddingTop="4dp"
                            android:paddingEnd="8dp"
                            android:paddingBottom="4dp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="🏞️ Naturaleza"
                            android:textSize="9sp"
                            android:textColor="#5B43B4"
                            android:background="@drawable/bg_chip"
                            android:layout_marginStart="5dp"
                            android:paddingStart="8dp"
                            android:paddingTop="4dp"
                            android:paddingEnd="8dp"
                            android:paddingBottom="4dp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="🏛️ Cultura"
                            android:textSize="9sp"
                            android:textColor="#5B43B4"
                            android:background="@drawable/bg_chip"
                            android:layout_marginStart="5dp"
                            android:paddingStart="8dp"
                            android:paddingTop="4dp"
                            android:paddingEnd="8dp"
                            android:paddingBottom="4dp" />

                    </LinearLayout>

                </HorizontalScrollView>

            </LinearLayout>

        </LinearLayout>


        <!-- ===================================================== -->
        <!-- RESUMEN PROFESIONAL -->
        <!-- ===================================================== -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card"
            android:elevation="1dp"
            android:layout_marginTop="10dp"
            android:padding="12dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="📌 Resumen profesional"
                android:textColor="@color/app_primary"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/txtDescripcion"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Apasionado por la cultura, historia, gastronomía y diversidad natural de Colombia."
                android:textColor="@color/text_secondary"
                android:textSize="11sp"
                android:lineSpacingExtra="2dp"
                android:layout_marginTop="6dp" />

        </LinearLayout>


        <!-- ===================================================== -->
        <!-- ESTUDIOS -->
        <!-- ===================================================== -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/bg_card"
            android:elevation="1dp"
            android:layout_marginTop="10dp"
            android:padding="12dp">

            <!-- ICONO -->

            <TextView
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:gravity="center"
                android:text="🎓"
                android:textSize="22sp"
                android:background="@drawable/bg_chip" />

            <!-- TEXTO -->

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginStart="10dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Estudios"
                    android:textColor="@color/text_primary"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/txtEstudios"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Tecnología en Gestión Turística."
                    android:textColor="@color/text_secondary"
                    android:textSize="11sp"
                    android:lineSpacingExtra="2dp"
                    android:layout_marginTop="4dp" />

            </LinearLayout>

        </LinearLayout>


        <!-- ===================================================== -->
        <!-- EXPERIENCIA -->
        <!-- ===================================================== -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/bg_card"
            android:elevation="1dp"
            android:layout_marginTop="10dp"
            android:padding="12dp">

            <!-- ICONO -->

            <TextView
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:gravity="center"
                android:text="🧭"
                android:textSize="22sp"
                android:background="@drawable/bg_chip" />

            <!-- TEXTO -->

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginStart="10dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Experiencia"
                    android:textColor="@color/text_primary"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/txtExperiencia"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Recorridos culturales y naturales en diferentes regiones de Colombia."
                    android:textColor="@color/text_secondary"
                    android:textSize="11sp"
                    android:lineSpacingExtra="2dp"
                    android:layout_marginTop="4dp" />

            </LinearLayout>

        </LinearLayout>


        <!-- ===================================================== -->
        <!-- SOBRE EL PERFIL -->
        <!-- ===================================================== -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/bg_card"
            android:elevation="1dp"
            android:layout_marginTop="10dp"
            android:padding="12dp">

            <!-- ICONO -->

            <TextView
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:gravity="center"
                android:text="⭐"
                android:textSize="20sp"
                android:background="@drawable/bg_chip" />

            <!-- INFORMACIÓN -->

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginStart="10dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Sobre el perfil"
                    android:textColor="@color/text_primary"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Experiencia en turismo, cultura regional, destinos naturales y patrimonio colombiano."
                    android:textColor="@color/text_secondary"
                    android:textSize="11sp"
                    android:lineSpacingExtra="2dp"
                    android:layout_marginTop="4dp" />

            </LinearLayout>

        </LinearLayout>


        <!-- ===================================================== -->
        <!-- PIE DECORATIVO -->
        <!-- ===================================================== -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_profile_hero">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🇨🇴"
                android:textSize="20sp"
                android:layout_marginEnd="7dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Conociendo Colombia, un destino a la vez"
                android:textColor="@color/app_primary"
                android:textSize="10sp"
                android:textStyle="bold" />

        </LinearLayout>

    </LinearLayout>

</ScrollView>