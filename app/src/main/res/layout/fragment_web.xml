<?xml version="1.0" encoding="utf-8"?>

<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/app_background"
    android:padding="14dp">


    <!-- ===================================================== -->
    <!-- TÍTULO -->
    <!-- ===================================================== -->

    <TextView
        android:id="@+id/txtTituloWeb"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="🌐 Explorador web"
        android:textColor="@color/text_primary"
        android:textSize="18sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Consulta contenido web sin salir de Conoce Colombia."
        android:textColor="@color/text_secondary"
        android:textSize="10sp"
        android:layout_marginTop="3dp"
        android:layout_marginBottom="12dp" />


    <!-- ===================================================== -->
    <!-- BARRA DE NAVEGACIÓN -->
    <!-- ===================================================== -->

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="54dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/bg_web_url"
        android:elevation="2dp"
        android:paddingStart="10dp"
        android:paddingEnd="6dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🔗"
            android:textSize="15sp"
            android:paddingEnd="6dp" />

        <EditText
            android:id="@+id/edtUrl"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@android:color/transparent"
            android:hint="https://www.colombia.co"
            android:inputType="textUri"
            android:imeOptions="actionGo"
            android:singleLine="true"
            android:textColor="@color/text_primary"
            android:textColorHint="@color/text_secondary"
            android:textSize="10sp"
            android:paddingStart="4dp"
            android:paddingEnd="4dp" />

        <Button
            android:id="@+id/btnIr"
            android:layout_width="54dp"
            android:layout_height="38dp"
            android:text="Ir"
            android:textAllCaps="false"
            android:textColor="@android:color/white"
            android:textStyle="bold"
            android:textSize="11sp"
            android:backgroundTint="@color/app_primary"
            android:minHeight="0dp"
            android:minWidth="0dp" />

    </LinearLayout>


    <!-- ===================================================== -->
    <!-- ESTADO -->
    <!-- ===================================================== -->

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="42dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="8dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🔒"
            android:textSize="12sp"
            android:layout_marginEnd="5dp" />

        <TextView
            android:id="@+id/txtEstadoWeb"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Navegación integrada"
            android:textColor="@color/text_secondary"
            android:textSize="10sp" />

        <TextView
            android:id="@+id/btnRecargarWeb"
            android:layout_width="38dp"
            android:layout_height="34dp"
            android:gravity="center"
            android:text="↻"
            android:textColor="@color/app_primary"
            android:textSize="19sp"
            android:textStyle="bold"
            android:background="@drawable/bg_web_control"
            android:clickable="true"
            android:focusable="true" />

    </LinearLayout>


    <!-- ===================================================== -->
    <!-- PROGRESO -->
    <!-- ===================================================== -->

    <ProgressBar
        android:id="@+id/progressWeb"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="3dp"
        android:max="100"
        android:progress="0"
        android:progressTint="@color/app_primary"
        android:progressBackgroundTint="#E5E7EB"
        android:visibility="gone" />


    <!-- ===================================================== -->
    <!-- NAVEGADOR -->
    <!-- ===================================================== -->

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_web_card"
        android:elevation="3dp"
        android:padding="3dp">

        <WebView
            android:id="@+id/webView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@android:color/white" />

    </FrameLayout>


    <!-- ===================================================== -->
    <!-- PIE -->
    <!-- ===================================================== -->

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/bg_card"
        android:layout_marginTop="9dp"
        android:paddingStart="12dp"
        android:paddingEnd="12dp">

        <TextView
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:gravity="center"
            android:text="🇨🇴"
            android:textSize="20sp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="7dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Explora Colombia"
                android:textColor="@color/text_primary"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Turismo, cultura, gastronomía y naturaleza."
                android:textColor="@color/text_secondary"
                android:textSize="9sp"
                android:layout_marginTop="2dp" />

        </LinearLayout>

    </LinearLayout>

</LinearLayout>