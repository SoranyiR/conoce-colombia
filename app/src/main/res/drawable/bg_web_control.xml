<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Cuando se presiona -->
    <item android:state_pressed="true">

        <shape>

            <solid android:color="#DDD6FE" />

            <stroke
                android:width="1dp"
                android:color="#C4B5FD" />

            <corners android:radius="10dp" />

        </shape>

    </item>

    <!-- Estado normal -->
    <item>

        <shape>

            <solid android:color="#F1EDFF" />

            <stroke
                android:width="1dp"
                android:color="#D8CCFF" />

            <corners android:radius="10dp" />

        </shape>

    </item>

</selector>